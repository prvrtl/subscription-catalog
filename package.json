{
  "name": "subscription-catalog",
  "version": "0.2.0",
  "description": "Subscription services, plans, prices and brand marks, focused on the German market",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./data": "./data/services.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "data",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "validate": "node scripts/validate.mjs",
    "test": "node scripts/validate.mjs && vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  },
  "license": "MIT"
}
